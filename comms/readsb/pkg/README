
 sudo /usr/local/bin/readsb --device-type rtlsdr \
--gain 42.1 \
--sdr-buffer-size 256 \
--interactive

sudo /usr/local/bin/readsb \
  --device-type hackrf \
  --sdr-buffer-size 256 \
  --hackrf-vgagain 32 \
  --interactive

HackRF or RTLSDR via SoapySDR
sudo /usr/local/bin/readsb \
  --device-type soapysdr \
  --gain 40 \
  --interactive

--write-json /var/run/readsb

stream to dump1090 to see planes on the map:

dump1090 --net --net-only --interactive

sudo /usr/local/bin/readsb --device-type rtlsdr \
--gain 42.1 \
--sdr-buffer-size 256 \
--net \
--net-connector 127.0.0.1,30001,raw_out

